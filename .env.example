# ===========================================================================
#  Neuralbrain — example configuration
#
#  Three AI-backed functions:   summarize | consolidate | embed
#  (There is deliberately no `compress`. Capture never calls a model — see
#   rule 1 in CLAUDE.md. Rolling up old observations is `consolidate` on an
#   age trigger, operating on rows that are already stored.)
#
#  Copy to .env and edit. Every value below is a default except where marked.
# ===========================================================================


# ---------------------------------------------------------------------------
#  Service
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3737
# Internal host binding (0.0.0.0 inside container, 127.0.0.1 on local host)
HOST=127.0.0.1
# Host binding for published Docker ports (127.0.0.1 binds to localhost only)
HOST_BIND=127.0.0.1

# URL where the Neuralbrain HTTP service is reachable by your agents, MCP, and hooks.
# Change this to another host/LAN IP or cloud URL (e.g. https://brain.example.com) if running Brain remotely:
BRAIN_API_URL=http://127.0.0.1:3737

# SQLite file — the source of truth. Defaults to ./data/brain.db
DATABASE_URL=./data/brain.db

# Qdrant — an index, rebuildable from SQLite at any time
# (Use http://localhost:6333 on host; http://qdrant:6333 inside Docker Compose)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# ---------------------------------------------------------------------------
#  AI Endpoints & Remote Models (Ollama, LM Studio, vLLM, etc.)
# ---------------------------------------------------------------------------
# NOTE: By default, BRAIN_AI=agent and BRAIN_EMBED=local, so neither BRAIN_ENDPOINT
# nor cloud API keys are called or required for out-of-the-box operation!
#
# Generative chat (BRAIN_AI) and vector embeddings (BRAIN_EMBED) are toggled INDEPENDENTLY:
# - You can set BRAIN_EMBED=remote (generating embeddings via Ollama or LM Studio) while
#   keeping BRAIN_AI=agent (no remote chat model used).
# - BRAIN_ENDPOINT serves as the default base URL for any function set to tier `remote`.
# - If your embedding server runs on a different port or host from your chat server,
#   you can optionally set BRAIN_EMBED_ENDPOINT specifically for embeddings.

BRAIN_ENDPOINT=http://localhost:11434/v1
BRAIN_ENDPOINT_API_KEY=                  # usually blank; LM Studio/Ollama need no key

# Optional: Separate endpoint for embeddings if different from BRAIN_ENDPOINT
# (used only when BRAIN_EMBED=remote):
# BRAIN_EMBED_ENDPOINT=http://localhost:11434/v1
# BRAIN_EMBED_API_KEY=

# The one cloud vendor, used wherever a tier resolves to `vendor`
BRAIN_VENDOR=                            # openai | anthropic | google
# The GENERATIVE model only (summarize/consolidate). Defaults per vendor:
#   openai gpt-4o-mini | anthropic claude-3-5-haiku | google gemini-2.0-flash
# The embedder's model is BRAIN_EMBED_MODEL, never this. One variable cannot
# mean both: setting a chat model here used to silently re-point the vendor
# embedder at a model that cannot embed, which store_meta then pinned.
BRAIN_VENDOR_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=


# ---------------------------------------------------------------------------
#  Generative functions — tiers: none | agent | remote | vendor
#
#    none    disabled. A finished state, not a broken one.
#    agent   the host agent (Claude Code/Desktop, Antigravity) does it over
#            MCP, at session end or before context compaction. No key, no
#            model, and it holds the conversation rather than just the rows.
#    remote  a chat model on BRAIN_ENDPOINT.
#    vendor  BRAIN_VENDOR.
#
#  `local` is NOT available here — it means in-process, and only an encoder
#  can load in-process. An embedding model cannot summarise.
# ---------------------------------------------------------------------------
BRAIN_AI=agent                           # default tier for all generative functions

# Placeholder: currently no table or leasing surface exists for session-grain summaries;
# reserved for future session-grain workers. Inherits BRAIN_AI.
BRAIN_AI_SUMMARIZE=                      # override; inherits BRAIN_AI (placeholder)
BRAIN_AI_CONSOLIDATE=                    # override; inherits BRAIN_AI

BRAIN_CHAT_MODEL=                        # `remote` tier only; a NON-REASONING build
BRAIN_CHAT_TIMEOUT_MS=60000              # applies to `remote` AND `vendor`
BRAIN_CHAT_MAX_TOKENS=2000               # raise sharply if the model reasons

# Ordered fallback tiers, e.g. `remote,vendor`. Permitted for generative
# functions because every derived row records the producer that actually
# answered (rule 6) — unlike the embedder, which may never fall back.
BRAIN_AI_FALLBACK=
BRAIN_CHAT_BREAKER_THRESHOLD=3           # failures before the circuit opens
BRAIN_CHAT_BREAKER_COOLDOWN_MS=30000     # cooldown before one half-open probe
BRAIN_CHAT_FIELD_CHARS=4000              # per-field cap when rendering a prompt

# Probe `reasoning_tokens` on a real response at startup and size the budget
# from what the endpoint actually does. Do not trust a no-think flag: neither
# `/no_think` nor `enable_thinking:false` was honoured on tested hardware,
# and a reasoning build burned 5,820 of 6,000 tokens thinking, returning
# nothing. Set 0 to skip the probe.
BRAIN_CHAT_PROBE=1


# ---------------------------------------------------------------------------
#  Embedding — tiers: none | local | local-gpu | remote | vendor
#
#    none       no vectors. SQL + BM25 retrieval only. Needs no model at all;
#               the smallest useful deployment.
#    local      in-process CPU ONNX via @huggingface/transformers. Self-contained.
#    local-gpu  managed GPU ONNX sidecar (`embedder-gpu` via Docker Compose
#               `gpu` profile). Requires NVIDIA GPU, host drivers, and
#               nvidia-container-toolkit; not available in `local-only` mode.
#    remote     an embedding model on BRAIN_EMBED_ENDPOINT or BRAIN_ENDPOINT.
#               Uses an external server (Ollama, LM Studio, etc.).
#    vendor     BRAIN_VENDOR (google = gemini-embedding-001).
#
#  Separate from BRAIN_AI on purpose: this is the one irreversible choice.
#  The resolved identity is pinned in `store_meta` on first use; a later
#  mismatch refuses vector search loudly and points at the re-embed job.
#  It never silently re-points.
# ---------------------------------------------------------------------------
BRAIN_EMBED=local
# Owns "which model" for EVERY embedder tier, vendor included.
#   local / local-gpu -> nomic | minilm
#   remote            -> the endpoint's model name
#   vendor            -> google gemini-embedding-001 | openai text-embedding-3-small
BRAIN_EMBED_MODEL=nomic
BRAIN_EMBED_DIM=512                      # nomic Matryoshka: 768|512|256|128|64

# Optional overrides for `BRAIN_EMBED=local-gpu` (Docker Compose `gpu` profile):
# BRAIN_GPU_PORT=7997
# BRAIN_GPU_ENDPOINT=http://127.0.0.1:7997   # auto-set to http://embedder-gpu:7997 in Docker mode
# BRAIN_GPU_IMAGE=michaelf34/infinity:latest
# BRAIN_GPU_MODEL_ID=nomic-ai/nomic-embed-text-v1.5
# BRAIN_GPU_ENGINE=optimum                   # optimum (ONNX) | torch

# `minilm` (all-MiniLM-L6-v2, 384d) is smaller and ~6x faster, but its
# 256-wordpiece limit truncates 21% of a real ~200-note corpus. Offered for
# tight hosts; never selected automatically.

BRAIN_EMBED_BATCH=32
BRAIN_EMBED_CONCURRENCY=4                # workers draining the pending queue


# ---------------------------------------------------------------------------
#  Retention
#     observations  high volume, machine-written
#     trajectories  one task attempt with an outcome
#     notes         authored on purpose — NEVER auto-deleted
# ---------------------------------------------------------------------------
BRAIN_OBS_ARCHIVE_DAYS=30
BRAIN_OBS_DELETE_DAYS=90

# OPEN QUESTION: rule 5 says trajectories get "long
# retention" but names no number. 0 = never delete, pending that decision.
BRAIN_TRAJECTORY_ARCHIVE_DAYS=180
BRAIN_TRAJECTORY_DELETE_DAYS=0

# A summarised observation archives instead of deleting, so a derived row's
# sources outlive it (rule 6 requires this to be true).
BRAIN_KEEP_SUMMARIZED_SOURCES=1

# ---------------------------------------------------------------------------
#  Rollup sweeper (D29)
#  A client that crashes mid-task never sends the explicit rollup signal, so
#  without this its observations are captured and then never used. A swept
#  rollup's success is NULL (unknown) — never 1.
# ---------------------------------------------------------------------------
BRAIN_ROLLUP_IDLE_MINUTES=30             # session idle before it is swept
BRAIN_ROLLUP_SWEEP_INTERVAL_MS=300000    # background interval; timer is unref'ed
BRAIN_DISABLE_ROLLUP_SWEEP=              # =1 disables the interval; endpoint still works


# ---------------------------------------------------------------------------
#  Auth and limits
# ---------------------------------------------------------------------------
# Optional pre-configured static API key for agents, MCP, and operator dashboard.
# If set, brain registers this key on startup. If left commented out/unset, you can
# claim your first key via the dashboard UI or generate one via POST /maintenance/api-keys.
# BRAIN_API_KEY=your-secret-api-key-here
BRAIN_REQUIRE_API_KEY=1

BRAIN_RATE_LIMIT_WINDOW_MS=60000
BRAIN_RATE_LIMIT_MAX=100

# Paths exempt from rate limiting. Capture MUST be exempt — rule 3 forbids
# rejecting a write for volume, and hook-driven capture exceeds 100/min in
# seconds.
BRAIN_RATE_LIMIT_EXEMPT=/health,/capture


# ---------------------------------------------------------------------------
#  Client spool (transport failures) — 5 MB cap, 168 h max age, dedupe
# ---------------------------------------------------------------------------
BRAIN_SPOOL_PATH=~/.neuralbrain/spool
BRAIN_SPOOL_MAX_BYTES=5242880
BRAIN_SPOOL_MAX_AGE_HOURS=168


# ===========================================================================
#  Replaced from NeuralSwarm — do NOT set these; they are gone
#
#    LEARNING_EMBEDDING_PROVIDER  -> BRAIN_EMBED + BRAIN_VENDOR
#    OLLAMA_HOST                  -> BRAIN_ENDPOINT
#    OPENAI_COMPATIBLE_URL        -> BRAIN_ENDPOINT
#    OPENAI_COMPATIBLE_API_KEY    -> BRAIN_ENDPOINT_API_KEY
#    LEARNING_DIMENSION_PROBE     -> replaced by the store_meta check (D7)
#    LEARNING_DISABLE_QDRANT      -> BRAIN_EMBED=none
#    LEARNING_DISABLE_HNSW        -> BRAIN_EMBED=none
#
#  LEARNING_DISABLE_HNSW was especially bad: engine.ts assigns to it at
#  runtime (lines 195, 222) to disable Qdrant after a failed dimension probe,
#  so the service rewrote its own configuration and kept serving as though
#  nothing had happened. Replaced by a loud refusal.
# ===========================================================================


# ===========================================================================
#  Docker Compose Operations
#
#  Start the entire stack (Brain + Qdrant):
#    docker compose up -d --build
#
#  Check container health status:
#    docker compose ps
#
#  Follow logs:
#    docker compose logs -f brain
#
#  Run operational commands inside the container:
#    # Run health checks & AI conformance doctor
#    docker compose exec brain node dist/scripts/doctor.js [--ai|--no-ai]
#
#    # Generate a client API key
#    docker compose exec brain node dist/scripts/createApiKey.js --name "my-agent"
#
#    # Run MCP server over stdio
#    docker compose exec -i -e BRAIN_API_KEY=<key> brain node dist/mcp/server.js
# ===========================================================================
