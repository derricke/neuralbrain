{
  "name": "neuralbrain",
  "version": "0.1.0",
  "description": "Standalone memory service (brain) for coding agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "neuralbrain": "dist/cli.js"
  },
  "files": [
    "dist",
    "docker-compose.yml",
    "docker-compose.qdrant-port.yml",
    "Dockerfile",
    "plugin",
    ".env.example",
    ".dockerignore",
    "npm-shrinkwrap.json",
    "tsconfig.json",
    "src",
    "!src/tests",
    "!dist/tests"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "mcp": "ts-node src/mcp/server.ts",
    "doctor": "ts-node src/scripts/doctor.ts",
    "smoke": "ts-node src/scripts/smokeTest.ts",
    "migrate:agentmemory": "ts-node src/scripts/migrateAgentMemory.ts",
    "api-key:create": "ts-node src/scripts/createApiKey.ts",
    "preinstall-agent": "npm run build",
    "install-agent": "ts-node src/scripts/installAgent.ts",
    "brain:install": "npm run build && node dist/cli.js install",
    "qdrant:start": "docker compose -f docker-compose.yml -f docker-compose.qdrant-port.yml up -d qdrant",
    "qdrant:stop": "docker compose stop qdrant",
    "typecheck": "tsc --noEmit",
    "skills:check": "jest src/tests/scripts/skillsDrift.test.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "pretest": "npm run build"
  },
  "keywords": [
    "memory",
    "mcp",
    "model-context-protocol",
    "coding-agents",
    "claude-code",
    "sqlite",
    "qdrant",
    "vector-search",
    "embeddings"
  ],
  "author": "Derrick Emery (https://github.com/derricke)",
  "license": "MIT AND Commons-Clause",
  "type": "commonjs",
  "overrides": {
    "react-is-19": "npm:react-is@19.2.7",
    "@babel/core": {
      "semver": "6.3.1"
    },
    "brace-expansion": "5.0.9",
    "@hono/node-server": "1.19.17"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@qdrant/js-client-rest": "1.18.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "openai": "6.38.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.3",
    "@types/supertest": "7.2.0",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "sharp": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "unrs-resolver": false
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derricke/neuralbrain.git"
  },
  "homepage": "https://github.com/derricke/neuralbrain#readme",
  "bugs": {
    "url": "https://github.com/derricke/neuralbrain/issues"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "3.3.3"
  }
}
