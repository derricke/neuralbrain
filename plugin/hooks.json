{
  "neuralbrain": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ~/.neuralbrain/hooks/sessionStart.js",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.neuralbrain/hooks/postToolUse.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ~/.neuralbrain/hooks/sessionStop.js",
        "timeout": 5
      }
    ]
  }
}
